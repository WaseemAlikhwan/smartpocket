        <mxCell id="n1" value="NFR-01 Performance&#xa;- Fast local CRUD (SQLite)&#xa;- Lightweight state refresh (Riverpod invalidation)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="170" width="620" height="180" as="geometry"/></mxCell>
        <mxCell id="n2" value="NFR-02 Reliability&#xa;- Migrations handled up to DB v8&#xa;- FK constraints enabled&#xa;- Data remains local/offline" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="620" height="180" as="geometry"/></mxCell>
        <mxCell id="n3" value="NFR-03 Usability&#xa;- Clear tab/shell navigation&#xa;- Add/Edit forms with validation&#xa;- Localized Arabic labels in UI sections" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1420" y="170" width="620" height="180" as="geometry"/></mxCell>
        <mxCell id="n4" value="NFR-04 Maintainability&#xa;- Layered architecture (presentation/domain/data)&#xa;- Repository contracts and DI providers&#xa;- Feature-based screens/providers split" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="100" y="390" width="620" height="200" as="geometry"/></mxCell>
        <mxCell id="n5" value="NFR-05 Portability&#xa;- Flutter project supports Android/iOS/Web/Desktop&#xa;- SQLite FFI path for desktop platforms" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="760" y="390" width="620" height="200" as="geometry"/></mxCell>
        <mxCell id="n6" value="NFR-06 Security/Privacy&#xa;- No external backend/API dependency in app flow&#xa;- User finance data stored locally on device" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1420" y="390" width="620" height="200" as="geometry"/></mxCell>
        <mxCell id="n7" value="NFR-07 Observability (basic)&#xa;- In-app feedback (SnackBar/messages)&#xa;- Deterministic provider refresh patterns" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="620" height="180" as="geometry"/></mxCell>
